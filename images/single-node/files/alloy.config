// Ships the journal and the shop's log files to Loki on the host.
loki.write "host" {
  endpoint {
    url = "http://telemetry.opsschool.internal:13100/loki/api/v1/push"
  }
}

loki.relabel "journal" {
  forward_to = []
  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }
}

loki.source.journal "system" {
  forward_to    = [loki.write.host.receiver]
  relabel_rules = loki.relabel.journal.rules
  labels        = { job = "journal", host = "scenario-vm" }
}

local.file_match "shop" {
  path_targets = [{ __path__ = "/data/log/shop/*.log", job = "shop", host = "scenario-vm" }]
  sync_period  = "5s"
}

loki.source.file "shop" {
  targets    = local.file_match.shop.targets
  forward_to = [loki.write.host.receiver]
}
