# Shop configuration. Read by shop.service, shop-worker.service and the
# maintenance cron job. Restart the services after changing it.
SHOP_LISTEN=127.0.0.1:8080
SHOP_ADMIN_LISTEN=0.0.0.0:9091
SHOP_LOG_LEVEL=info
SHOP_LOG_FILE=/data/log/shop/app.log
SHOP_DB_DSN=shop:shop@unix(/run/mysqld/mysqld.sock)/shop
SHOP_DB_REPLICA_DSN=
SHOP_READ_FROM_REPLICA=false
SHOP_DB_POOL_SIZE=20
SHOP_DB_MAX_IDLE=10
SHOP_DB_QUERY_TIMEOUT=5s
SHOP_REDIS_ADDR=127.0.0.1:6379
SHOP_CACHE_TTL=60s
SHOP_WORKER_CONCURRENCY=4
SHOP_WORKER_BUFFER_MB=32
SHOP_PAYMENTS_URL=http://127.0.0.1:8081
SHOP_CLIENT_TIMEOUT=2s
SHOP_CLIENT_KEEPALIVE=true
SHOP_RETRY_MAX=2
SHOP_RETRY_BACKOFF=100ms
SHOP_SESSION_DIR=/data/sessions
